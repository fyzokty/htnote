{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Capability for the main window only",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-set-preview-draft",
    "allow-clear-preview-draft",
    "opener:allow-reveal-item-in-dir",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "http://*" },
        { "url": "https://*" },
        { "url": "mailto:*" }
      ]
    }
  ]
}
